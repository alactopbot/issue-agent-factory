{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue Agent Factory explicitly authorized requirement pattern",
  "type": "object",
  "required": ["id", "version", "enabled", "activation", "scope", "execution"],
  "properties": {
    "$schema": { "const": "../pattern.schema.json" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "enabled": { "type": "boolean" },
    "activation": {
      "type": "object",
      "required": ["issueLabel"],
      "properties": {
        "issueLabel": { "type": "string", "pattern": "^factory:pattern:[a-z0-9]+(?:-[a-z0-9]+)*$" }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["allowedPaths", "preserved"],
      "properties": {
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "preserved": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["planReview", "gateLevel", "independentVerification", "completion"],
      "properties": {
        "planReview": { "const": "none" },
        "gateLevel": { "enum": ["fast", "full", "deep"] },
        "independentVerification": { "const": "required" },
        "completion": { "const": "verified-pr" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
