{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue Agent Factory reusable requirement pattern",
  "type": "object",
  "required": ["id", "version", "maturity", "appliesWhen", "allowedChanges", "preserved", "humanGates", "promotion", "demoteOn"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "maturity": { "enum": ["bootstrap", "supervised", "trusted", "autonomous"] },
    "appliesWhen": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "allowedChanges": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "preserved": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "humanGates": {
      "type": "object",
      "required": ["bootstrap", "supervised", "trusted", "autonomous"],
      "properties": {
        "bootstrap": { "const": ["spec-ready", "merge"] },
        "supervised": { "const": ["spec-ready", "merge"] },
        "trusted": { "const": ["merge"] },
        "autonomous": { "const": ["merge"] }
      },
      "additionalProperties": false
    },
    "promotion": {
      "type": "object",
      "required": ["consecutiveCleanRuns"],
      "properties": { "consecutiveCleanRuns": { "type": "integer", "minimum": 1 } }
    },
    "demoteOn": { "type": "array", "minItems": 1, "items": { "enum": ["human-spec-change", "human-product-change", "verifier-rejected", "escaped-defect", "scope-violation", "pattern-version-change"] } },
    "autonomousEligibility": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
