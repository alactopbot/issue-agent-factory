{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue Agent Factory project policy",
  "type": "object",
  "required": ["factoryVersion", "project", "tier", "language", "defaults", "automation", "evidence"],
  "properties": {
    "factoryVersion": { "const": 3 },
    "project": { "type": "string", "minLength": 1, "not": { "pattern": "^<.*>$" } },
    "tier": { "enum": ["revival", "greenfield", "oss", "client-production"] },
    "language": {
      "type": "object",
      "required": ["workflow", "productPrimary", "code"],
      "properties": {
        "workflow": { "type": "string", "minLength": 2, "not": { "pattern": "^<.*>$" } },
        "productPrimary": { "type": "string", "minLength": 2, "not": { "pattern": "^<.*>$" } },
        "code": { "type": "string", "minLength": 2 }
      },
      "additionalProperties": true
    },
    "defaults": {
      "type": "object",
      "required": ["planReview", "gateLevel", "completion"],
      "properties": {
        "planReview": { "const": "required" },
        "gateLevel": { "enum": ["fast", "full", "deep"] },
        "completion": { "const": "verified-pr" }
      },
      "additionalProperties": false
    },
    "automation": {
      "type": "object",
      "required": ["autoMerge", "autoDeploy"],
      "properties": {
        "autoMerge": { "const": false },
        "autoDeploy": { "const": false }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["liveState", "checks", "requirementDecision", "finalDelivery"],
      "properties": {
        "liveState": { "const": "github" },
        "checks": { "const": "github-checks" },
        "requirementDecision": { "const": "docs/requirements" },
        "finalDelivery": { "const": "docs/requirements-and-github-comment" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
