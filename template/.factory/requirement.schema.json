{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue Agent Factory requirement manifest",
  "type": "object",
  "required": ["schemaVersion", "requirement", "issue", "mode", "pattern", "reviewPr", "humanGates", "allowedPaths", "gateLevel"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requirement": { "type": "string", "pattern": "^REQ-[0-9]{3,}$" },
    "issue": { "type": "integer", "minimum": 1 },
    "mode": { "enum": ["bootstrap", "supervised", "trusted", "autonomous"] },
    "pattern": { "type": "string", "minLength": 1 },
    "reviewPr": { "type": "integer", "minimum": 1 },
    "humanGates": {
      "type": "array",
      "items": { "enum": ["spec-ready", "merge"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowedPaths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "gateLevel": { "enum": ["fast", "full", "deep"] }
  },
  "additionalProperties": false
}
